#!/bin/sh
# Recover USB WAN when a portable WiFi stick disappears or enumerates late.

INTERVAL=12
RESET_COOLDOWN=120
LAST_RESET=0
HAD_USBWAN=0

is_usb_net() {
	_dev="$1"
	case "$_dev" in
		lo|br-lan|wan|lan*|wlan*|phy*|bonding*|dummy*) return 1 ;;
	esac
	_path="$(readlink -f "/sys/class/net/${_dev}/device" 2>/dev/null)"
	echo "$_path" | grep -q "/usb"
}

driver_of() {
	basename "$(readlink -f "/sys/class/net/${1}/device/driver" 2>/dev/null)" 2>/dev/null
}

bind_to_usbwan() {
	_name="$1"
	[ -n "$_name" ] || return 1
	[ "$_name" = usbwan ] && return 0
	[ -d /sys/class/net/usbwan ] && return 0
	ip link set dev "$_name" down 2>/dev/null || true
	ip link set dev "$_name" name usbwan 2>/dev/null || return 1
	ip link set dev usbwan up 2>/dev/null || true
	ifup usbwan >/dev/null 2>&1 || true
	logger -t usbwan-watchdog "bound $_name -> usbwan"
}

reset_usb_net_devices() {
	_now="$(date +%s)"
	[ $((_now - LAST_RESET)) -ge "$RESET_COOLDOWN" ] || return 0
	LAST_RESET="$_now"
	for d in /sys/bus/usb/devices/[0-9]*; do
		[ -f "$d/bDeviceClass" ] || continue
		_hit=0
		_class="$(cat "$d/bDeviceClass" 2>/dev/null)"
		[ "$_class" = "e0" ] || [ "$_class" = "02" ] && _hit=1
		if [ "$_hit" = 0 ]; then
			for iface in "$d"/*:*; do
				[ -f "$iface/bInterfaceClass" ] || continue
				_ic="$(cat "$iface/bInterfaceClass" 2>/dev/null)"
				case "$_ic" in
					02|0a|e0) _hit=1 ;;
				esac
				[ "$_hit" = 1 ] && break
			done
		fi
		[ "$_hit" = 1 ] || continue
		logger -t usbwan-watchdog "reset USB $(basename "$d")"
		echo 0 > "$d/authorized" 2>/dev/null || true
		sleep 2
		echo 1 > "$d/authorized" 2>/dev/null || true
	done
}

while true; do
	sleep "$INTERVAL"

	if [ -d /sys/class/net/usbwan ]; then
		HAD_USBWAN=1
		ip link set dev usbwan up 2>/dev/null || true
		# If the link exists but netifd has not brought DHCP up, retry.
		if ! ubus call network.interface.usbwan status >/dev/null 2>&1; then
			ifup usbwan >/dev/null 2>&1 || true
		fi
		continue
	fi

	found=""
	for n in /sys/class/net/*; do
		dev="$(basename "$n")"
		is_usb_net "$dev" || continue
		drv="$(driver_of "$dev")"
		case "$drv" in
			qmi_wwan|cdc_mbim) continue ;;
		esac
		found="$dev"
		break
	done

	if [ -n "$found" ]; then
		bind_to_usbwan "$found"
		continue
	fi

	if [ "$HAD_USBWAN" = 1 ]; then
		reset_usb_net_devices
	fi
done
