#!/bin/sh
# First-boot defaults for JDCloud Arthur USB WAN build.

. /lib/functions.sh

uci -q batch <<-EOF
	set system.@system[0].hostname='ImmortalWrt'
	set system.@system[0].timezone='CST-8'
	set system.@system[0].zonename='Asia/Shanghai'
	set luci.main.lang='zh_cn'
	set luci.main.mediaurlbase='/luci-static/bootstrap'
EOF

if [ -z "$(uci -q get network.usbwan)" ]; then
	uci -q batch <<-EOF
		set network.usbwan=interface
		set network.usbwan.proto='dhcp'
		set network.usbwan.device='usbwan'
		set network.usbwan.metric='10'
		set network.usbwan.delegate='0'
		set network.usbwan.ipv6='0'
	EOF
fi

if [ -n "$(uci -q get network.wan)" ]; then
	uci -q set network.wan.metric='20'
fi

add_usbwan_to_wan_zone() {
	local cfg="$1"
	local name
	config_get name "$cfg" name
	[ "$name" = "wan" ] || return 0
	uci -q del_list firewall."$cfg".network='usbwan'
	uci -q add_list firewall."$cfg".network='usbwan'
}
config_load firewall
config_foreach add_usbwan_to_wan_zone zone

for radio in $(uci -q show wireless | awk -F'[.=]' '/wifi-device$/{print $2}'); do
	uci -q set "wireless.${radio}.disabled=0"
	uci -q set "wireless.${radio}.country=CN"
	band="$(uci -q get "wireless.${radio}.band")"
	iface=""
	for s in $(uci -q show wireless | awk -F'[.=]' '/wifi-iface$/{print $2}'); do
		[ "$(uci -q get "wireless.${s}.device")" = "$radio" ] || continue
		iface="$s"
		break
	done
	[ -n "$iface" ] || continue
	uci -q set "wireless.${iface}.disabled=0"
	uci -q set "wireless.${iface}.mode=ap"
	uci -q set "wireless.${iface}.network=lan"
	uci -q set "wireless.${iface}.encryption=psk2+ccmp"
	cur="$(uci -q get "wireless.${iface}.ssid")"
	case "$cur" in
		""|OpenWrt|ImmortalWrt|ImmortalWrt-*)
			if [ "$band" = "5g" ] || [ "$band" = "6g" ]; then
				uci -q set "wireless.${iface}.ssid=Arthur-5G"
			else
				uci -q set "wireless.${iface}.ssid=Arthur"
			fi
			uci -q set "wireless.${iface}.key=12345678"
			;;
	esac
done

if [ -f /etc/rc.local ] && ! grep -q usbcore /etc/rc.local; then
	sed -i '/exit 0/i echo -1 > /sys/module/usbcore/parameters/autosuspend 2>/dev/null || true' /etc/rc.local
fi

uci -q commit system
uci -q commit luci
uci -q commit network
uci -q commit firewall
uci -q commit wireless

[ -x /etc/init.d/usbwan-watchdog ] && /etc/init.d/usbwan-watchdog enable

exit 0
